<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="horizontal"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- Left Details Pane -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.55"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <!-- Header Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📿 ကိုးနဝင်းပုတီးစိပ်"
                android:textColor="#F59E0B"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_day_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Day -- / 81"
                android:textColor="#94A3B8"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- High contrast, large bold virtue name (Primary text) -->
        <TextView
            android:id="@+id/widget_virtue_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="စိပ်ရန်မရှိပါ"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:textStyle="bold"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="1dp" />

        <!-- Smaller, secondary supporting chant text (Lower priority, not bold) -->
        <TextView
            android:id="@+id/widget_chant_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="- ပတ်"
            android:textColor="#F59E0B"
            android:textSize="11.5sp"
            android:textStyle="normal"
            android:layout_marginTop="1dp"
            android:layout_marginBottom="3dp" />

        <!-- Vegetarian Day Notice -->
        <TextView
            android:id="@+id/widget_vegetarian_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🥗 သတ်သတ်လွတ်စားရမည့်ရက်"
            android:textColor="#10B981"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:layout_marginTop="1.5dp"
            android:layout_marginBottom="3.5dp"
            android:visibility="gone" />

        <!-- Hidden Weekday Info View (Kept for backwards compatibility / avoiding NPEs, but hidden) -->
        <TextView
            android:id="@+id/widget_weekday"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#334155"
            android:layout_marginTop="1dp"
            android:layout_marginBottom="1dp" />

        <!-- Tomorrow Preview Pane -->
        <TextView
            android:id="@+id/widget_tomorrow_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="မနက်ဖြန်: မရှိပါ"
            android:textColor="#CBD5E1"
            android:textSize="9.5sp" />
    </LinearLayout>

    <!-- Right Action Button Pane -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.45"
        android:gravity="center"
        android:orientation="vertical"
        android:layout_marginStart="6dp">

        <TextView
            android:id="@+id/widget_action_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_button_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="40dp"
            android:padding="6dp"
            android:text="✓ ပြီးပြီ"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
